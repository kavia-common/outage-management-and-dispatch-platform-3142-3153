{"is_source_file": true, "format": "bash script", "description": "This file is a startup script for setting up and managing a MySQL database server. It checks if the server is already running, initializes it if necessary, starts the server, configures database users and privileges, and generates connection instructions and environment variables.", "external_files": ["/var/run/mysqld/mysqld.sock", "db_connection.txt", "db_visualizer/mysql.env"], "external_methods": ["mysqladmin", "mysql", "mysqld", "sleep", "grep", "awk", "pgrep", "shutdown"], "published": ["DB_NAME", "DB_USER", "DB_PASSWORD", "DB_PORT"], "classes": [], "methods": [], "calls": ["sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -e \"USE ${DB_NAME};\"", "pgrep -f \"mysqld.*--port=${DB_PORT}\"", "mysql -u root -p${DB_PASSWORD} -h 127.0.0.1 -P ${DB_PORT} -e \"SELECT 1;\"", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -e 'SHOW VARIABLES LIKE \"port\";'", "sudo mysqladmin shutdown --socket=/var/run/mysqld/mysqld.sock", "sudo mysqld --initialize-insecure --user=mysql --datadir=/var/lib/mysql", "sudo mysqld --user=mysql --datadir=/var/lib/mysql --socket=/var/run/mysqld/mysqld.sock --pid-file=/var/run/mysqld/mysqld.pid --port=${DB_PORT}", "sleep 5", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "sudo mysql --socket=/var/run/mysqld/mysqld.sock << EOF ... EOF", "echo \"mysql -u ${DB_USER} -p${DB_PASSWORD} -h localhost -P ${DB_PORT} ${DB_NAME}\" > db_connection.txt", "cat > db_visualizer/mysql.env << EOF ... EOF"], "search-terms": ["startup.sh", "MySQL setup script", "database initialization", "MySQL server management", "MySQL user creation", "MySQL configuration"], "state": 2, "file_id": 7, "knowledge_revision": 14, "git_revision": "3093aa1cbe80d965bd413f13e52dfe0428faf58e", "hash": "6a67fea9b0c5bdde98ca1d42257dde05", "format-version": 4, "code-base-name": "database", "filename": "database/startup.sh", "revision_his