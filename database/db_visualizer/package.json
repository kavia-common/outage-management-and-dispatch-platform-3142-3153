{
  "name": "simple-db-viewer",
  "version": "1.0.0",
  "description": "Simple database viewer for PostgreSQL, MySQL, SQLite, and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --host 0.0.0.0",
    "dev": "nodemon server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongodb": "^6.2.0",
    "mysql2": "^3.6.3",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "passWithNoTests": false
  }
}
